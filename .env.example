# Copy to `.env` and fill in.  `.env` is gitignored - never commit a real key.
#
#   cp .env.example .env
#
# The pipeline runs end-to-end WITHOUT any key (deterministic extractor only).
# A key additionally enables the LLM extractor for prose-phrased facts.

# Google AI Studio key - free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: pin a preferred model. Blank = built-in default (gemini-2.5-flash).
FACTLAYER_LLM_MODEL=

# Optional: comma-separated models to try, in order, when the preferred one refuses -
# quota exhausted, model retired, or a name this key cannot reach. Leave commented out
# for the built-in chain; uncommenting with an empty value disables fallbacks entirely.
# FACTLAYER_LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash

# List what your key can actually reach, and check the whole chain:
#   python -m factlayer.cli models --check

# Optional: bounds on the LLM phase. Defaults in brackets. Calls run concurrently; a
# document spends at most CALL_BUDGET of them; no single call waits longer than
# TIMEOUT_SECONDS; the phase gives up at PHASE_DEADLINE and says what it skipped.
# FACTLAYER_LLM_MAX_WORKERS=8
# FACTLAYER_LLM_CALL_BUDGET=150
# FACTLAYER_LLM_TIMEOUT_SECONDS=25
# FACTLAYER_LLM_PHASE_DEADLINE=60

# Optional: set to 1 to hard-disable all LLM calls even if a key is present.
FACTLAYER_NO_LLM=0
